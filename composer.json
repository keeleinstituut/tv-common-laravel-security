{
    "name": "keeleinstituut/tv-common-laravel-security",
    "description": "Authorization lib of Tõlkevärav",
    "keywords": [
        "laravel",
        "keycloak"
    ],
    "require": {
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.12.1",
        "php": "^8.3"
    },
    "conflict": {
        "guzzlehttp/psr7": "<2.12.1"
    },
    "autoload": {
        "psr-4": {
            "KeycloakAuthGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeycloakAuthGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "KeycloakAuthGuard\\KeycloakAuthServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0",
        "laravel/pint": "^1.9",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "ext-openssl": "*"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
